# DEVELOPMENT ONLY. Production requires PostgreSQL and Better Auth.
ELEVA_ENV=development
DATABASE_URL=sqlite:///./eleva-development.db
AUTH_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:8081
ENABLE_TEST_IDENTITIES=false
# A random local secret, never embed in the app. Only used by isolated test identities.
TEST_IDENTITY_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=45
AI_PROJECT_DAILY_LIMIT=20
AI_USER_DAILY_LIMIT=5
AI_ALLOW_SYNTHETIC=false
AI_MIN_START_INTERVAL_SECONDS=60
AI_MAX_SNAPSHOT_CHARACTERS=6000
AI_MAX_COMPLETION_TOKENS=1500
# Empty until an actual qualified reviewer is designated. Profession alone cannot approve content.
PEDAGOGICAL_REVIEWER_SUBJECTS=
