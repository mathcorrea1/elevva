# Public endpoints, never credentials. Android needs reachable HTTPS endpoints (not localhost).
EXPO_PUBLIC_API_URL=http://localhost:8100
EXPO_PUBLIC_AUTH_URL=http://localhost:3001
# Enable only after media/child-directed YouTube requirements have been reviewed (D15).
# Development permits explicit adult-operated technical previews; text is always available.
EXPO_PUBLIC_YOUTUBE_EMBEDS_ENABLED=false
# Technical opt-in only after verifying WebGL/widget on the actual Android/iOS device.
EXPO_PUBLIC_LIBRAS_WEBVIEW_ENABLED=false
# Public static origin only, different from the app, API and identity origins.
# Local web app opens on localhost; the public frame uses 127.0.0.1 without app credentials.
EXPO_PUBLIC_LIBRAS_FRAME_URL=http://127.0.0.1:8081/libras-frame.html
